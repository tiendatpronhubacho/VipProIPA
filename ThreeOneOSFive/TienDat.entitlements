<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 1. QUYỀN CƠ BẢN -->
	<key>application-identifier</key>
	<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>get-task-allow</key>
	<true/>

	<!-- 2. QUYỀN SANDBOX & CONTAINER -->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.MobileGestalt</key>
	<true/>
	<key>com.apple.private.security.storage.MCMContainer</key>
	<true/>
	<key>com.apple.private.security.storage.SystemData</key>
	<true/>
	<key>com.apple.private.security.storage.SystemGroup</key>
	<true/>
	<key>com.apple.private.security.storage.SystemContainer</key>
	<true/>
	<key>com.apple.private.security.storage.SharedData</key>
	<true/>

	<!-- 3. QUYỀN MOBILE CONTAINER MANAGER -->
	<key>com.apple.private.MobileContainerManager</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.Tags</key>
	<array>
		<string>system</string>
		<string>application</string>
		<string>app-data</string>
		<string>app-group</string>
		<string>system-group</string>
	</array>

	<!-- 4. QUYỀN DEBUG & HOOK TIẾN TRÌNH -->
	<key>task_for_pid-allow</key>
	<true/>
	<key>com.apple.private.cs.debugger</key>
	<true/>
	<key>com.apple.private.cs.dyld</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>
	<key>dynamic-codesigning</key>
	<true/>
	<key>com.apple.private.amfi.can-load-cdhash</key>
	<true/>
	<key>com.apple.private.amfi.can-execute-cdhash</key>
	<true/>

	<!-- 5. QUYỀN MACH LOOKUP -->
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.springboard</string>
		<string>com.apple.backboardd</string>
		<string>com.apple.UIKit</string>
		<string>com.apple.frontboard.systemappservices</string>
		<string>com.apple.runningboard</string>
	</array>

	<!-- 6. QUYỀN QUẢN LÝ CÀI ĐẶT -->
	<key>com.apple.private.mobileinstall.upgrade-enabled</key>
	<true/>
	<key>com.apple.private.mobileinstall.allowedSPI</key>
	<array>
		<string>Lookup</string>
		<string>Install</string>
		<string>Uninstall</string>
	</array>

	<!-- 7. QUYỀN ĐỌC/GHI FILE HỆ THỐNG -->
	<key>com.apple.private.security.storage.InstallCoordination</key>
	<true/>
	<key>com.apple.private.security.storage.mobileassetd</key>
	<true/>
	<key>com.apple.private.security.storage.MobileAsset</key>
	<true/>
	<key>com.apple.private.security.storage.logd</key>
	<true/>
	<key>com.apple.private.security.storage.darwinup</key>
	<true/>
	<key>com.apple.private.security.storage.Diagnostics</key>
	<true/>
	<key>com.apple.private.security.storage.CoreDuet</key>
	<true/>
	<key>com.apple.private.security.storage.MobileDevice</key>
	<true/>
	<key>com.apple.private.security.storage.Preferences</key>
	<true/>
	<key>com.apple.private.security.storage.Preferences.app</key>
	<true/>
	<key>com.apple.private.security.storage.Preferences.domain</key>
	<true/>

	<!-- 8. CÁC DỊCH VỤ HỆ THỐNG -->
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>*</string>
	</array>
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.*</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.*</string>
	</array>
	<key>com.apple.developer.networking.multipath</key>
	<true/>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.developer.networking.vpn.api</key>
	<array>
		<string>allow-vpn</string>
	</array>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<key>com.apple.developer.pass-type-identifiers</key>
	<array>
		<string>*</string>
	</array>
	<key>com.apple.developer.siri</key>
	<true/>
	<key>com.apple.developer.user-fonts</key>
	<array>
		<string>system-installed</string>
	</array>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>inter-app-audio</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)*</string>
	</array>

	<!-- 9. QUYỀN KERNEL & BỘ NHỚ NÂNG CAO -->
	<key>kernel.extended-virtual-addressing</key>
	<true/>
	<key>kernel.increased-debug-memory-limit</key>
	<true/>
	<key>kernel.increased-memory-limit</key>
	<true/>
	<key>network.HotspotConfiguration</key>
	<true/>

	<!-- 10. QUYỀN GHI ĐÈ MÃ NGUỒN -->
	<key>com.apple.private.amfi.developer-mode</key>
	<true/>
	<key>com.apple.private.security.storage.CacheDelete</key>
	<true/>
	<key>com.apple.private.security.storage.CloudKit</key>
	<true/>
	<key>com.apple.private.security.storage.Maps</key>
	<true/>
	<key>com.apple.private.security.storage.Messages</key>
	<true/>
	<key>com.apple.private.security.storage.Photos</key>
	<true/>

	<!-- 11. QUYỀN MẠNG LƯỚI -->
	<key>com.apple.private.network.socket-delegate</key>
	<true/>
	<key>com.apple.private.network.system-administrator</key>
	<true/>
	<key>com.apple.private.network.socket</key>
	<true/>
	<key>com.apple.private.security.disk-image-writer</key>
	<true/>
	<key>com.apple.private.security.storage.external</key>
	<true/>

	<!-- 12. QUYỀN DANH TÍNH -->
	<key>com.apple.developer.identity-provider</key>
	<true/>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- 13. APP GROUP (CHO WORSE_QUERY) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.3L2ZTNPUUS.kE2gC0TJ</string>
		<string>group.3L2ZTNPUUS.USRrovNf</string>
		<string>group.3L2ZTNPUUS.NsL0</string>
		<string>group.3L2ZTNPUUS.eEw4</string>
		<string>group.3L2ZTNPUUS.fCsrGfn</string>
	</array>
</dict>
</plist>